{
  "cSpell.words": [
    "autonumber",
    "HMAC",
    "keepalive",
    "mcpsrv",
    "Streamable",
    "webmcp"
  ],
  "go.diagnostic.vulncheck": "Imports",
  "go.lintTool": "golangci-lint-v2",
  "go.lintFlags": [
    "--path-mode=abs",
    // TODO: fast-only is often detected in CI because heavy linters are skipped
    "--fast-only"
  ],
  "go.formatTool": "custom",
  "go.alternateTools": {
    "customFormatter": "golangci-lint-v2",
    "golangci-lint-v2": "${env:HOME}/.local/share/mise/shims/golangci-lint",
    "go": "${env:HOME}/.local/share/mise/shims/go"
  },
  "go.formatFlags": [
    "fmt",
    "--stdin"
  ]
}
