{
  "info": {
    "name": "Manifold tool filter / authz",
    "description": "End-to-end checks for tools.include/overrides and OPA tool authorization. Run with tests/postman/run.sh.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Parse the MCP response once for every request: Streamable HTTP answers with",
          "// SSE (data: lines) or plain JSON; the JSON-RPC message lands in `rpc`.",
          "let parsed = null;",
          "try {",
          "  const ct = (pm.response.headers.get('Content-Type') || '').toLowerCase();",
          "  const text = pm.response.text();",
          "  if (ct.includes('text/event-stream')) {",
          "    for (const line of text.split(/\\r?\\n/)) {",
          "      if (!line.startsWith('data:')) continue;",
          "      const msg = JSON.parse(line.slice(5).trim());",
          "      if (msg && Object.prototype.hasOwnProperty.call(msg, 'id')) parsed = msg;",
          "    }",
          "  } else if (ct.includes('application/json')) {",
          "    parsed = pm.response.json();",
          "  }",
          "} catch (e) {",
          "  parsed = null;",
          "}",
          "pm.variables.set('rpc', parsed ? JSON.stringify(parsed) : '');"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:19999"
    },
    {
      "key": "token",
      "value": "postman-token"
    }
  ],
  "item": [
