      "name": "Setup",
      "item": [
        {
          "name": "initialize",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const raw = pm.variables.get('rpc');",
                  "const rpc = raw ? JSON.parse(raw) : null;",
                  "const result = rpc && rpc.result;",
                  "const toolNames = () => (result.tools || []).map(t => t.name);",
                  "const callText = () => result.content[0].text;",
                  "",
                  "pm.test('200 and a JSON-RPC result', () => { pm.response.to.have.status(200); pm.expect(rpc, 'parsed response').to.not.equal(null); pm.expect(rpc.error, JSON.stringify(rpc && rpc.error)).to.equal(undefined); });",
                  "pm.test('serverInfo names the server', () => pm.expect(result.serverInfo.name).to.equal('petstore'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
