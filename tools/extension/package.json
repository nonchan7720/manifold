{
  "name": "@manifold/webmcp-extension",
  "private": true,
  "version": "0.1.0",
  "description": "Browser extension (MV3) that bridges WebMCP tools in a tab to Manifold's reverse connection gateway",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@mcp-b/transports": "4.0.0",
    "@mcp-b/webmcp-ts-sdk": "4.0.0",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@types/chrome": "0.2.6",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vite-plugin-web-extension": "4.5.1",
    "vitest": "4.1.11"
  }
}
