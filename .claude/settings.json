{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/mise-setup.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "command -v mise >/dev/null && mise exec -- sh -c 'command -v depgraph >/dev/null && depgraph hook prompt'; exit 0"
          }
        ]
      }
    ]
  }
}
