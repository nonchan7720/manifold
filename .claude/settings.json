{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/mise-setup.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "command -v mise >/dev/null && command -v depgraph >/dev/null && MISE_EXEC_AUTO_INSTALL=0 mise exec -- depgraph hook prompt; exit 0"
          }
        ]
      }
    ]
  }
}
