{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/mise-setup.sh"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "depgraph": {
      "source": {
        "source": "github",
        "repo": "nonchan7720/depgraph",
        "ref": "v0.1.5"
      }
    }
  },
  "enabledPlugins": {
    "depgraph@depgraph": true
  }
}
