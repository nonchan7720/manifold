{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/mise-setup.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "command -v mise >/dev/null || exit 0; mise which depgraph >/dev/null 2>&1 || exit 0; MISE_EXEC_AUTO_INSTALL=0 mise exec -- depgraph hook prompt; exit 0"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "depgraph": {
      "source": {
        "source": "github",
        "repo": "nonchan7720/depgraph",
        "ref": "v0.1.11"
      }
    }
  },
  "enabledPlugins": {
    "depgraph@depgraph": true
  }
}
